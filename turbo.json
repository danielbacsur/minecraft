{
  "$schema": "https://turborepo.dev/schema.json",

  "tasks": {
    "dev": {
      "cache": false,
      "persistent": true
    },

    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": [".next/**", "!.next/cache/**", "!.next/dev/**"],
      "env": [
        "ANTHROPIC_API_KEY",
        "BETTER_AUTH_SECRET",
        "BETTER_AUTH_URL",
        "DISCORD_CLIENT_ID",
        "DISCORD_CLIENT_SECRET",
        "GOOGLE_CLIENT_ID",
        "GOOGLE_CLIENT_SECRET",
        "GOOGLE_TRANSLATE_API_KEY",
        "KV_REST_API_TOKEN",
        "KV_REST_API_URL",
        "MICROSOFT_CLIENT_ID",
        "MICROSOFT_CLIENT_SECRET",
        "POSTGRES_URL",
        "POSTGRES_URL_NON_POOLING",
        "VOYAGE_API_KEY"
      ]
    }
  }
}
