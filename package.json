{
  "name": "minecraft",
  "version": "0.0.0",
  "private": true,

  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev"
  },

  "devDependencies": {
    "prettier": "^3",
    "turbo": "^2"
  },

  "overrides": {
    "drizzle-orm": "1.0.0-rc.4"
  },

  "engines": {
    "node": ">=24"
  },

  "devEngines": {
    "packageManager": {
      "name": "npm",
      "version": "^11"
    }
  },

  "workspaces": [
    "apps/minecraft-frontend",
    "datasets/minecraft-skins-20k-1024k-captioned",
    "packages/minecraft-auth",
    "packages/minecraft-corpus",
    "packages/minecraft-postgres",
    "packages/minecraft-resources",
    "packages/minecraft-stripe"
  ],

  "allowScripts": {
    "esbuild@0.25.12": true
  }
}
