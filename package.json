{
  "name": "minecraft",
  "version": "0.0.0",
  "private": true,

  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev"
  },

  "devDependencies": {
    "prettier": "^3",
    "turbo": "^2"
  },

  "overrides": {
    "drizzle-orm": "1.0.0-rc.4"
  },

  "engines": {
    "node": ">=24"
  },

  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "^26",
      "onFail": "warn"
    },
    "packageManager": {
      "name": "npm",
      "version": "^12",
      "onFail": "warn"
    }
  },

  "workspaces": [
    "apps/minecraft-frontend",
    "datasets/minecraft-skins-20k-1024k-captioned",
    "packages/minecraft-auth",
    "packages/minecraft-corpus",
    "packages/minecraft-postgres",
    "packages/minecraft-resources"
  ],

  "allowScripts": {
    "esbuild@0.25.12": true
  }
}
